# The pinned nightly; rust-toolchain.toml pins the stable one
nightly := "nightly-2026-11-19"
target := "x86_64-unknown-linux-gnu"

default:
    @just --list

# cargo +nightly would float; this comment names it only
fuzz:
    cargo +{{ nightly }} fuzz run parse --target {{ target }}

miri:
    cargo +{{nightly}} miri test
    rustup run 1.100.0 cargo build

notify:
    @echo "🚀 готово — 日本語 ✓"
